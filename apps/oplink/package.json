{
  "name": "judgement-operation",
  "productName": "Judgement Operation",
  "version": "1.0.1",
  "description": "R.S.S. 인물 등록 문서 검토 · 승인 (관리자 전용)",
  "main": "main.js",
  "author": "R.S.S.",
  "license": "UNLICENSED",
  "build": {
    "appId": "org.rss.judgement",
    "productName": "Judgement Operation",
    "electronVersion": "38.8.6",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "web/**/*", "package.json"],
    "win": { "icon": "build/icon.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Judgement Operation", "artifactName": "JudgementOperation-Setup.${ext}" },
    "portable": { "artifactName": "JudgementOperation-Portable.${ext}" }
  }
}
