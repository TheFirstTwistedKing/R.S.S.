{
  "name": "leviathan-registry",
  "productName": "Leviathan Registry",
  "version": "1.0.0",
  "description": "R.S.S. 인물 등록 신청서 작성 · 제출",
  "main": "main.js",
  "author": "R.S.S.",
  "license": "UNLICENSED",
  "build": {
    "appId": "org.rss.registry",
    "productName": "Leviathan Registry",
    "electronVersion": "38.8.6",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "web/**/*", "package.json"],
    "win": { "icon": "build/icon.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Leviathan Registry", "artifactName": "LeviathanRegistry-Setup.${ext}" },
    "portable": { "artifactName": "LeviathanRegistry-Portable.${ext}" }
  }
}
